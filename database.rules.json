{
  "rules": {
    ".read": false,
    ".write": false,
    "c": {
      "$id": {
        ".read": false,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['m', 's', 't'])",
        "m": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 == 0"
        },
        "s": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150 && newData.val() % 1 == 0"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= 1700000000000 && newData.val() <= 1999999999999 && newData.val() % 1 == 0"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
