{
  "rules": {
    ".read": false,
    ".write": false,
    "memoryGameScores": {
      "$scoreId": {
        ".read": false,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['level', 'cards', 'moves', 'seconds', 'completedAt'])",
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && newData.val() % 1 == 0"
        },
        "cards": {
          ".validate": "newData.isNumber() && newData.val() >= 6 && newData.val() <= 36 && newData.val() % 1 == 0"
        },
        "moves": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 == 0"
        },
        "seconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150 && newData.val() % 1 == 0"
        },
        "completedAt": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
